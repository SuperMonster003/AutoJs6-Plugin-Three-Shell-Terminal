<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The vendored jackpal AARs declare minSdk 4 / targetSdk 22; the plugin's own values apply. -->
    <uses-sdk tools:overrideLibrary="jackpal.androidterm,jackpal.androidterm.emulatorview,jackpal.androidterm.libtermexec" />

    <uses-permission android:name="org.autojs.permission.PLUGIN" />
    <!-- The shell runs under this plugin's uid (not the host's), so it cannot inherit the host's
         storage grants and has to declare storage access itself; mirrors the host and the Node.js
         Runtime plugin manifests. MANAGE_EXTERNAL_STORAGE still needs the user to grant "All files
         access" for this plugin in system settings (roadmap D6 / D18). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Sessions keep running after the terminal screen is left (roadmap D15); the service lands in P2.1. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Shell children (npm, corepack, curl ...) use the network under this uid; the manual release check does too. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="org.autojs.autojs6" />
        <!-- Node.js Runtime plugin: NODE_CLI_* meta-data, signing certificate and native library directory (roadmap D17). -->
        <package android:name="io.github.supermonster003.autojs6.plugin.nodejs" />
        <intent>
            <action android:name="org.autojs.plugin.nodejs.RUNTIME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher_system"
        android:roundIcon="@mipmap/ic_launcher_system"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThreeShellTerminal"
        tools:targetApi="33">

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="16384" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />
        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Host entry (roadmap D19 / P3.3): the only way the host opens the terminal UI. Exported behind the PLUGIN
            signature permission, invisible, left out of recents; it checks the caller it can name, validates the
            contract extras and forwards to the terminal screen (own task) or the session manager, then finishes.
        -->
        <activity
            android:name=".ThreeShellTerminalEntryActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.TERMINAL_OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Launcher target (roadmap D30 / P3.3): invisible forwarder to the terminal screen (most recent session or a
            new one at home). Shares the terminal's task affinity so the task the home screen creates is the terminal
            task. Not exported; the launcher icon aliases below carry MAIN / LAUNCHER and point here.
        -->
        <activity
            android:name=".ui.LauncherActivity"
            android:exported="false"
            android:taskAffinity="io.github.supermonster003.autojs6.plugin.three.shell.terminal.ui.TerminalActivity"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
            Launcher icon aliases (roadmap P5.3, icon specification): MAIN / LAUNCHER live only here, exactly one alias is
            enabled at a time (ui/settings/LauncherIcons.kt switches them through PackageManager; the manifest default is
            the automatic adaptive icon), and all four target the private LauncherActivity above.
        -->
        <activity-alias
            android:name=".launcher.AdaptiveLightIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system_light"
            android:roundIcon="@mipmap/ic_launcher_system_light"
            android:targetActivity=".ui.LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.AdaptiveDarkIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system"
            android:roundIcon="@mipmap/ic_launcher_system"
            android:targetActivity=".ui.LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.AdaptiveAutoIconAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system_auto"
            android:roundIcon="@mipmap/ic_launcher_system_auto"
            android:targetActivity=".ui.LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.TransparentIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".ui.LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            Terminal screen (roadmap P3.1 / D30): its own task affinity so it stacks neither on the host nor on the
            launcher; the keyboard resizes the layout and opens with the screen. Not exported: the host reaches it
            through the guarded entry Activity above, the launcher alias of P5.3 through LauncherActivity.
        -->
        <activity
            android:name=".ui.TerminalActivity"
            android:exported="false"
            android:launchMode="standard"
            android:taskAffinity="io.github.supermonster003.autojs6.plugin.three.shell.terminal.ui.TerminalActivity"
            android:theme="@style/Theme.ThreeShellTerminal.Terminal"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!--
            Session manager as a standalone dialog (roadmap P3.2): tap target of the session notification and the
            host's manager=true entry (P3.3). Transparent, left out of recents, reused while it is on top.
        -->
        <activity
            android:name=".ui.TerminalManagerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ThreeShellTerminal.Transparent" />

        <service
            android:name=".ThreeShellTerminalPluginInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="terminal" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="5304" />
        </service>

        <!--
            Host-facing terminal service (roadmap D3 / D20). Until the host terminal-api contract lands
            (roadmap P1.1 / P2.4) it answers a placeholder Binder carrying the contract descriptor.
        -->
        <service
            android:name=".ThreeShellTerminalPluginService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.TERMINAL" />
                <category android:name="terminal" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="5304" />
        </service>

        <!--
            Foreground lifetime of running sessions (roadmap D15, P2.1): started by TerminalSessionManager while at
            least one shell lives, stopped when the last one exits. Never exported, no intent filter; the specialUse
            subtype explains the use case to the platform (API 34+).
        -->
        <service
            android:name=".service.ThreeShellTerminalSessionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the interactive terminal shells of 3-Shell Terminal and the processes they run (scripts, npm, node) alive while the user is away from the terminal screen" />
        </service>

        <!-- Package update only (roadmap P5.3): re-normalizes the launcher alias states so exactly one entry stays enabled. -->
        <receiver
            android:name=".ui.settings.LauncherIconUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
